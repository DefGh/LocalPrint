<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="org.localprint" android:versionCode="1" android:versionName="0.1.0">
    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="36" />
    <uses-permission android:name="android.permission.INTERNET" />
    <application android:label="LocalPrint" android:theme="@style/AppTheme" android:icon="@drawable/ic_print"
        android:allowBackup="false" android:usesCleartextTraffic="true" android:supportsRtl="true">
        <activity android:name="org.localprint.android.MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <service android:name="org.localprint.android.LocalPrintService" android:label="LocalPrint" android:exported="true" android:permission="android.permission.BIND_PRINT_SERVICE">
            <intent-filter><action android:name="android.printservice.PrintService" /></intent-filter>
            <meta-data android:name="android.printservice" android:resource="@xml/print_service" />
        </service>
    </application>
</manifest>
